rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Trusted Admin Check: In /admins collection OR bootstrapped verified developer email OR users role
    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email == 'landverseauto@gmail.com' ||
          request.auth.token.email.lower() == 'landverseauto@gmail.com'
        )) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // User Profile Validation
    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100 &&
             data.role in ['admin', 'employee'] &&
             data.status in ['active', 'disabled'] &&
             (!('email' in data) || (data.email is string && data.email.size() <= 150)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('title' in data) || (data.title is string && data.title.size() <= 100));
    }

    // Office Map Validation
    function isValidOfficeMap(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 64 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.schemaVersion is number &&
             data.mapVersion is number &&
             data.status in ['draft', 'published'] &&
             data.mapData is map;
    }

    // General Config Validation
    function isValidGeneralConfig(data) {
      return data.platformName is string && data.platformName.size() > 0 && data.platformName.size() <= 100 &&
             data.activeMapId is string && data.activeMapId.size() > 0 && data.activeMapId.size() <= 64 &&
             (!('publishedMapVersion' in data) || data.publishedMapVersion is number) &&
             (!('maintenanceMode' in data) || data.maintenanceMode is bool) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // HQ Weather Config Validation
    function isValidHQWeatherConfig(data) {
      return data.location is string && data.location.size() > 0 && data.location.size() <= 100 &&
             data.latitude is number && data.latitude >= -90 && data.latitude <= 90 &&
             data.longitude is number && data.longitude >= -180 && data.longitude <= 180 &&
             data.timezone is string && data.timezone.size() > 0 && data.timezone.size() <= 64 &&
             data.weatherEnabled is bool &&
             (!('refreshIntervalMinutes' in data) || (data.refreshIntervalMinutes is number && data.refreshIntervalMinutes >= 1)) &&
             (!('rainEffectsEnabled' in data) || data.rainEffectsEnabled is bool) &&
             (!('lightingEffectsEnabled' in data) || data.lightingEffectsEnabled is bool) &&
             (!('windowEffectsEnabled' in data) || data.windowEffectsEnabled is bool) &&
             (!('sourcePreference' in data) || (data.sourcePreference is string && data.sourcePreference.size() <= 50)) &&
             (!('updatedBy' in data) || (data.updatedBy is string && data.updatedBy.size() <= 128));
    }

    // Asset Metadata Validation
    function isValidAssetMetadata(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.category is string && data.category.size() <= 32 &&
             data.fileName is string && data.fileName.size() <= 256 &&
             data.width is number && data.width > 0 && data.width <= 4096 &&
             data.height is number && data.height > 0 && data.height <= 4096 &&
             data.frameWidth is number && data.frameWidth >= 8 &&
             data.frameHeight is number && data.frameHeight >= 8 &&
             data.columns is number && data.columns >= 1 && data.columns <= 64 &&
             data.rows is number && data.rows >= 1 && data.rows <= 64 &&
             (!('storageBackend' in data) || data.storageBackend in ['indexeddb', 'firebase', 'none']) &&
             (!('ownerUid' in data) || (data.ownerUid is string && data.ownerUid.size() <= 128)) &&
             (!('thumbnailDataUrl' in data) || (data.thumbnailDataUrl is string && data.thumbnailDataUrl.size() <= 500000));
    }

    // World Validation
    function isValidWorld(data) {
      return data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 128 &&
             data.schemaVersion is number &&
             data.version is number &&
             data.maps is list && data.maps.size() <= 200;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && isValidId(userId);

      // Create: User can only create their own document, must default to employee unless admin
      allow create: if isSignedIn() && isValidId(userId) && request.auth.uid == userId &&
                       incoming().uid == userId &&
                       isValidUserProfile(incoming()) &&
                       (incoming().role == 'employee' || isAdmin());

      // Update: Admin can update any field; Owner can only update non-RBAC fields
      allow update: if isSignedIn() && isValidId(userId) && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().uid == existing().uid &&
          incoming().role == existing().role &&
          incoming().status == existing().status &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'title', 'avatarConfig', 'updatedAt'])
        )
      );

      allow delete: if isAdmin() && isValidId(userId);
    }

    // 2. Admins Whitelist Collection
    match /admins/{adminId} {
      allow read: if isSignedIn() && isValidId(adminId);
      allow write: if isAdmin() && isValidId(adminId);
    }

    // 3. Office Maps Collection
    match /officeMaps/{mapId} {
      // Employees can only read published maps; Admins can read all maps (drafts and published)
      allow get: if isValidId(mapId) && (
        isAdmin() || (isSignedIn() && resource.data.status == 'published')
      );

      allow list: if isSignedIn() && (
        isAdmin() || resource.data.status == 'published'
      );

      // Only admins can create, update, or delete maps
      allow create: if isAdmin() && isValidId(mapId) && isValidOfficeMap(incoming());
      allow update: if isAdmin() && isValidId(mapId) && isValidOfficeMap(incoming());
      allow delete: if isAdmin() && isValidId(mapId);
    }

    // 4. Platform Configuration
    match /platformConfig/{configId} {
      allow read: if isSignedIn() && isValidId(configId);

      allow create, update: if isAdmin() && isValidId(configId) && (
        (configId == 'general' && isValidGeneralConfig(incoming())) ||
        (configId == 'hqWeather' && isValidHQWeatherConfig(incoming()))
      );

      allow delete: if isAdmin() && isValidId(configId);
    }

    // 5. Asset Library Metadata
    // Binary images live in IndexedDB on-device (and Firebase Storage when
    // configured); this collection stores only metadata + thumbnails.
    match /assets/{assetId} {
      allow get: if isSignedIn() && isValidId(assetId);
      allow list: if isSignedIn();

      // Any signed-in user can register an asset they imported.
      allow create: if isSignedIn() && isValidId(assetId) &&
                       isValidAssetMetadata(incoming()) &&
                       incoming().ownerUid == request.auth.uid;

      // Creator or admin can update metadata; the owner cannot be reassigned.
      allow update: if isSignedIn() && isValidId(assetId) &&
                       isValidAssetMetadata(incoming()) &&
                       (isAdmin() || existing().ownerUid == request.auth.uid) &&
                       (isAdmin() || incoming().ownerUid == existing().ownerUid);

      allow delete: if isSignedIn() && isValidId(assetId) &&
                       (isAdmin() || existing().ownerUid == request.auth.uid);
    }

    // 6. Worlds (groupings of maps)
    match /worlds/{worldId} {
      allow get: if isSignedIn() && isValidId(worldId);
      allow list: if isSignedIn();

      allow create, update: if isAdmin() && isValidId(worldId) && isValidWorld(incoming());
      allow delete: if isAdmin() && isValidId(worldId);
    }
  }
}
